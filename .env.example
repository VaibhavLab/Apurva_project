FLASK_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret-key
# MySQL is the primary academic database. Comment this line for SQLite demo mode.
DATABASE_URL=mysql+pymysql://mindcare:your-password@localhost/mental_health_chatbot?charset=utf8mb4
SESSION_COOKIE_SECURE=false
PORT=5000

# Optional Google Gemini: keys stay on the Flask server. Restart after changing.
GEMINI_API_KEY=
GEMINI_ENABLED=false
VOICE_ENABLED=false
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_TRANSCRIBE_MODEL=gemini-flash-latest
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
GEMINI_TIMEOUT_SECONDS=30
VOICE_MAX_SECONDS=30
VOICE_MAX_UPLOAD_BYTES=2097152
